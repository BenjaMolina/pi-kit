{
  "name": "@benjamolina/pi-kit",
  "version": "0.7.0",
  "private": false,
  "description": "Reusable Pi resources and an OpenCode CLIProxyAPI plugin.",
  "type": "module",
  "main": "./opencode/cliproxyapi.ts",
  "exports": "./opencode/cliproxyapi.ts",
  "bin": {
    "pi-kit-codex": "./bin/pi-kit-codex.ts",
    "pi-kit-copilot": "./bin/pi-kit-copilot.ts"
  },
  "license": "MIT",
  "author": "BenjaMolina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenjaMolina/pi-kit.git"
  },
  "homepage": "https://github.com/BenjaMolina/pi-kit#readme",
  "bugs": {
    "url": "https://github.com/BenjaMolina/pi-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.1.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "opencode",
    "cliproxyapi"
  ],
  "files": [
    "extensions/",
    "opencode/",
    "profiles/",
    "prompts/",
    "skills/",
    "src/",
    "bin/",
    "themes/",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "test:pack": "bun scripts/pack-consumer.ts",
    "test:release-manifest": "bun scripts/release-manifest-check.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "devDependencies": {
    "opencode-ai": "1.18.18"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5"
  }
}
